# Copy to a file OUTSIDE git (for example deploy/.env.local, which is ignored) and fill in. PLACEHOLDERS ONLY.
# On Render you set these in the dashboard (or render.yaml), not in a file. Never commit real values.

# --- read by the app (app/config.py) ---
APP_BACKEND=mock                         # mock | llama_cpp. The Docker image supports mock only
APP_DB_PATH=/data/familycare.sqlite3     # SQLite file; its directory must be writable by the app user
APP_HTTPS=1                              # 1 behind TLS (Render): Secure cookies + HSTS. 0 for plain http://localhost
APP_SECRET_KEY=replace-with-a-long-random-string    # python -c "import secrets; print(secrets.token_hex(32))"
APP_SESSION_TTL_HOURS=168                # absolute session lifetime
APP_INVITE_TTL_DAYS=7                    # invitation lifetime
APP_JOB_ISOLATION=thread                 # auto | thread | process (thread is right for the mock backend)
APP_JOB_TIMEOUT_SECONDS=900              # only used with process isolation (real model)
APP_MAX_PENDING_PER_CIRCLE=3             # notes waiting/running per care circle
APP_MAX_PENDING_TOTAL=20                 # notes waiting/running in the whole app
APP_TRUSTED_PROXIES=                     # exact proxy addresses, comma-separated; EMPTY unless you verified them
APP_SEED_PASSWORD=replace-with-12-or-more-characters   # only for `python -m app.dev_seed`

# --- read by the container start command, not by the app ---
PORT=10000                               # Render sets this itself (default 10000)
